<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F4EE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hour Ledger"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#18181B"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in with your mobile number"
            android:textSize="14sp"
            android:textColor="#52525B"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="+919876543210"
            android:text="+91"
            android:inputType="phone"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send verification code"
            android:backgroundTint="#C2410C"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvDevOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#15803D"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter 6-digit OTP"
            android:inputType="number"
            android:maxLength="6"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnVerifyOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify and Sign In"
            android:backgroundTint="#18181B"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#3F3F46"
            android:textSize="13sp"
            android:layout_marginTop="18dp" />

    </LinearLayout>
</ScrollView>
